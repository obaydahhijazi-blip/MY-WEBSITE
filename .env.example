# ───────── Public (safe in the browser) ─────────
# Canonical site URL used for metadata, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://obaydah.example

# Sanity CMS — from sanity.io/manage → your project. Empty = site uses the bundled content/*.json.
NEXT_PUBLIC_SANITY_PROJECT_ID=iz5tq94u
NEXT_PUBLIC_SANITY_DATASET=production

# Only change for self-hosted Cal.com / Cal.com EU (default https://app.cal.com). The event link itself is edited in /admin.
NEXT_PUBLIC_CAL_ORIGIN=

# Sample (DEMO) projects, logos and testimonials, clearly labelled. On automatically in `npm run dev`.
# Set to 1 only on a preview deployment; leave empty in production. Set 0 to hide them during development.
NEXT_PUBLIC_DEMO_CONTENT=

# Real visitor analytics (Umami). Empty = no tracking and the admin shows «لم يتم إعداد التحليلات».
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SHARE_URL=
NEXT_PUBLIC_UMAMI_SRC=

# ───────── Server-only secrets (never prefix with NEXT_PUBLIC_) ─────────
# Sanity → API → Tokens → "Viewer" token. Enables draft preview from the Studio.
SANITY_API_READ_TOKEN=
# Random string; also pasted into the Sanity webhook (refreshes the site right after "Publish").
SANITY_REVALIDATE_SECRET=
# LOCAL USE ONLY for `npm run cms:seed` — do not add to the hosting provider; delete the token afterwards.
# SANITY_API_WRITE_TOKEN=

# Optional: automatic owner notification for Cal.com bookings (see docs/BOOKING_AND_WHATSAPP.md)
CAL_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_OWNER_NUMBER=963964766503
